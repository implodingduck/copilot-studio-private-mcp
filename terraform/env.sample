# Copy to terraform/.env (git-ignored), edit, and load from the repository root:
#   set -a; source terraform/.env; set +a
# Interactive deployment uses az login. Terraform can alternatively use
# ARM_TENANT_ID, ARM_CLIENT_ID and ARM_CLIENT_SECRET for CI; keep secrets out
# of source control. The deploy script requires Azure CLI login.

export ARM_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
export TF_VAR_subscription_id="$ARM_SUBSCRIPTION_ID"
export TF_VAR_gh_repo="implodingduck/copilot-studio-private-mcp"
export TF_VAR_location="eastus"
export TF_VAR_secondary_location="westus"
export TF_VAR_power_platform_geo="unitedstates"

# Optional overrides use Terraform expressions for lists and objects.
# export TF_VAR_power_platform_admin_object_ids='["00000000-0000-0000-0000-000000000000"]'

# After saving the custom connector, copy its exact generated callback URL here.
# export TF_VAR_connector_redirect_uris='["https://global.consent.azure-apim.net/redirect/EXACT-CONNECTOR-URL"]'

# Recommended: managed identity authentication. Copy the exact issuer and subject
# from the custom connector Security page, then reload this file and apply.
# export TF_VAR_connector_federation='{"issuer":"https://EXACT-ISSUER-FROM-CONNECTOR/","subject":"EXACT-SUBJECT-FROM-CONNECTOR"}'

# For a supported single-region geography, set TF_VAR_secondary_location="".
# scripts/deploy.sh persists the image digest in mcp.auto.tfvars.json.
